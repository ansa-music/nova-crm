rules_version = '2';

// ---------------------------------------------------------------------------
// Access model: the workspace Owner has blanket access to everything. A
// Тимлид (role 'teamlead') manages people and settings like the Owner but
// sees desk tables only with the Технар add-on role (extraRoles) — see
// isTeamLead/hasFullAccess/isDeskBlocked. Every
// other member — regardless of role — can only read/write a page (and its
// rows) if their uid is explicitly listed in that page's `allowedUsers`
// array. This is the actual security boundary; the React app's own checks
// (utils/permissions.ts) exist only for UX and must never be relied on alone.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Invite stubs are keyed by lowercase email. Token email may be mixed case.
    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function memberDoc(workspaceId, uid) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid));
    }

    function isMember(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function myRole(workspaceId) {
      return memberDoc(workspaceId, request.auth.uid).data.role;
    }

    function isDocOwner(workspaceId) {
      return signedIn() &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('ownerId', '') == request.auth.uid;
    }

    function isOwner(workspaceId) {
      return isDocOwner(workspaceId) || (isMember(workspaceId) && myRole(workspaceId) == 'owner');
    }

    // Тимлид: people and settings like the Owner — members, join requests,
    // roles, desk ACLs, workspace settings, announcements — but NO desk
    // tables: canAccessPage/canEditPage/canUsePersonalZone exclude them even
    // if they end up responsible for or listed on a desk. Owner-only on top
    // of that: deleting the workspace and any Owner membership.
    function isTeamLead(workspaceId) {
      return isMember(workspaceId) && myRole(workspaceId) == 'teamlead';
    }

    function hasFullAccess(workspaceId) {
      return isOwner(workspaceId) || isTeamLead(workspaceId);
    }

    // Add-on roles on top of the main `role` (members.extraRoles: 'manager'
    // = Технар, 'os' = ОС) — Owner + Технар, Тимлид + Технар, Тимлид + ОС.
    // Rights add up. People/settings rights still come from `role` alone;
    // add-ons only open desks (Технар), Грок (Технар) and ratings (ОС).
    function hasExtraRole(workspaceId, role) {
      return isMember(workspaceId)
        && role in memberDoc(workspaceId, request.auth.uid).data.get('extraRoles', []);
    }

    function hasRole(workspaceId, role) {
      return isMember(workspaceId) && (myRole(workspaceId) == role || hasExtraRole(workspaceId, role));
    }

    // A Тимлид who isn't also a Технар: no desk tables. A Тимлид + ОС stays
    // blocked; a Тимлид + Технар opens desks like any Технар.
    function isDeskBlocked(workspaceId) {
      return isTeamLead(workspaceId) && !hasExtraRole(workspaceId, 'manager');
    }

    // Owner or Admin (Выдача carries order data, so not Тимлид).
    function isOwnerOrAdmin(workspaceId) {
      return isOwner(workspaceId) || (isMember(workspaceId) && myRole(workspaceId) == 'admin');
    }

    // Owner, Тимлид or Admin: announcements, Grok card titles.
    function isManagement(workspaceId) {
      return hasFullAccess(workspaceId) || (isMember(workspaceId) && myRole(workspaceId) == 'admin');
    }

    // NOTE: the rules language has no list comprehensions (filter/all/map).
    // A former columnStatusOptionsPreserved() helper was built on them; it
    // "compiled" with warnings but threw at runtime, silently denying every
    // non-Owner write that reached it. Per-column statusOptions are dead
    // anyway (status lists are workspace-wide, Owner-managed on the
    // workspace doc), so column edits need no such check.

    function isResponsiblePage(workspaceId, pageData) {
      return isMember(workspaceId) && pageData.get('responsibleUserId', null) == request.auth.uid;
    }

    // Gates a page's Personal Space (Reports/Finance/Notes): the Owner
    // always; the page's own responsible person for THEIR OWN zone; anyone
    // else only for their OWN zone AND only if explicitly listed in
    // personalZoneAllowedUsers. Regular page access (allowedUsers) is
    // deliberately NOT sufficient here — Personal Space is a stricter,
    // separate gate on top of the parent page ACL.
    function canUsePersonalZone(workspaceId, pageData, zoneUid) {
      return isOwner(workspaceId)
        || (!isDeskBlocked(workspaceId) && (
          (isResponsiblePage(workspaceId, pageData) && zoneUid == request.auth.uid)
          || (isMember(workspaceId) && zoneUid == request.auth.uid
              && request.auth.uid in pageData.get('personalZoneAllowedUsers', []))));
    }

    // Owner: every page. Тимлид: none. Responsible person: their own desk
    // even if hidden or missing from allowedUsers. Everyone else: explicit
    // allowedUsers grant.
    function canAccessPage(workspaceId, pageData) {
      return isOwner(workspaceId) ||
        (!isDeskBlocked(workspaceId) && (
          isResponsiblePage(workspaceId, pageData) ||
          (isMember(workspaceId) && request.auth.uid in pageData.get('allowedUsers', []))));
    }

    // Viewers can open a page but never write row data on it.
    // Being in allowedUsers only grants VIEW access now. Editing row data
    // (or managing subpages) requires being explicitly listed in
    // editableUsers too — a separate grant the Owner or this page's
    // responsible person controls independently of plain view access.
    function canEditPage(workspaceId, pageData) {
      return isOwner(workspaceId) ||
        (!isDeskBlocked(workspaceId) && (
          pageData.get('responsibleUserId', null) == request.auth.uid ||
          (canAccessPage(workspaceId, pageData) && request.auth.uid in pageData.get('editableUsers', []))));
    }

    // ---------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Workspaces
    // ---------------------------------------------------------------------
    match /workspaces/{workspaceId} {
      // Any signed-in user may read the workspace's own top-level doc (name,
      // icon, color, ownerId — nothing sensitive) so the public /join/:id
      // page can show "Request access to «Name»" before they're a member.
      // Everything under it (members, pages, rows, history) stays gated by
      // isMember()/isOwner() as before.
      allow read: if signedIn();
      // Only this one account may create new workspaces. Everyone else
      // must be invited or approved via a /join/:workspaceId request — see
      // the joinRequests block below. Keep in sync with
      // src/utils/adminAccess.ts (WORKSPACE_ADMIN_EMAIL) on the client.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.token.email == 'nurpro2005@gmail.com';
      allow update: if isOwner(workspaceId);
      // Тимлид: every workspace setting, never the ownership itself.
      allow update: if isTeamLead(workspaceId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      // Deleting the workspace stays Owner-only — no Тимлид branch.
      allow delete: if isOwner(workspaceId);

      // -----------------------------------------------------------------
      // Members — only the Owner manages membership, roles, and removal.
      // -----------------------------------------------------------------
      match /members/{memberId} {
        // Existing members can read the full roster. A signed-in user who
        // is NOT yet a member may still read the one pending-invite doc
        // that matches their own email — otherwise claimPendingInvites()
        // could never find its own invite to accept (chicken-and-egg).
        // Own uid-keyed member doc is always readable by that user, even when
        // the doc does not exist (otherwise a missing members/{uid} get is
        // permission-denied and the app toasts «Нет доступа к части данных»).
        allow read: if isMember(workspaceId) ||
          (signedIn() && memberId == request.auth.uid) ||
          (signedIn() && request.auth.token.email is string && resource.data.email == authEmailLower() && resource.data.status == 'invited');

        // Self-service: a member may update just their own nickname,
        // presence heartbeat, and/or simulated activeRole ("Переключение
        // режима привилегий") on their own member doc — without needing
        // Owner-level member-management rights for anything else.
        //
        // activeRole is capped by the member's REAL, Owner-controlled
        // `role` field (resource.data.role — never writable by this same
        // rule, since 'role' is not in the allowed affectedKeys set below,
        // so it can only ever reflect what the Owner actually granted):
        //   role == owner    -> activeRole in [owner, teamlead, admin, manager, os, viewer]
        //   role == teamlead -> activeRole in [teamlead, admin, manager, os, viewer]  (never owner)
        //   role == admin    -> activeRole in [admin, manager, os, viewer]  (never owner/teamlead)
        //   role == manager, os or viewer -> may not set activeRole at all
        // This is the actual security boundary for the feature — nothing
        // else in this file ever reads activeRole, so even a raw DevTools
        // Firestore write can't grant real elevated access, only flip this
        // purely-informational field within limits the person's true role
        // already permits.
        allow update: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'lastActiveAt', 'activeRole', 'hiddenPageIds'])
          && (
            !('activeRole' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.activeRole == null
            || (resource.data.role == 'owner' &&
                request.resource.data.activeRole in ['owner', 'teamlead', 'admin', 'manager', 'os', 'viewer'])
            || (resource.data.role == 'teamlead' &&
                request.resource.data.activeRole in ['teamlead', 'admin', 'manager', 'os', 'viewer'])
            || (resource.data.role == 'admin' &&
                request.resource.data.activeRole in ['admin', 'manager', 'os', 'viewer'])
          );

        // Owner manages any membership record: invite, change role, remove.
        allow create, update, delete: if isOwner(workspaceId);

        // Тимлид manages membership the same way — invites, join approvals,
        // role changes, removal — except anything touching an Owner: never
        // the workspace's ownerId doc, never a record whose role is or
        // becomes 'owner'. (delete has no request.resource — only resource.)
        // Add-on roles may only be Технар/ОС. A Тимлид never changes their
        // own roles, ОС nick or membership — the Owner or another Тимлид does.
        allow create: if isTeamLead(workspaceId)
          && request.resource.data.get('role', '') != 'owner'
          && request.resource.data.get('extraRoles', []).hasOnly(['manager', 'os'])
          && memberId != request.auth.uid
          && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('ownerId', '');
        allow update: if isTeamLead(workspaceId)
          && resource.data.get('role', '') != 'owner'
          && request.resource.data.get('role', '') != 'owner'
          && request.resource.data.get('extraRoles', []).hasOnly(['manager', 'os'])
          && (memberId != request.auth.uid
            || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'extraRoles', 'osNick', 'osNickValue', 'status', 'uid', 'email']))
          && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('ownerId', '');
        allow delete: if isTeamLead(workspaceId)
          && resource.data.get('role', '') != 'owner'
          && memberId != request.auth.uid
          && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('ownerId', '');

        // Bootstrap: the workspace creator may create their own Owner record.
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;

        // Invite acceptance: a user may create their own uid-keyed record
        // only if a matching PENDING invite (keyed by their lowercase email)
        // exists, and role/email must match exactly what was invited.
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.auth.token.email is string
          && request.resource.data.email == authEmailLower()
          && request.resource.data.status == 'active'
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.resource.data.email))
          && memberDoc(workspaceId, request.resource.data.email).data.status == 'invited'
          && memberDoc(workspaceId, request.resource.data.email).data.role == request.resource.data.role;

        // Instant join: when the Owner has turned on Workspace.autoApproveJoins,
        // a brand-new signed-in user may create their OWN member record
        // directly — skipping the joinRequests pending/approve dance
        // entirely. Hard-locked to role 'manager' / status 'active' (the
        // same DEFAULT_JOIN_ROLE approveJoinRequest() always used), so this
        // can never be used to self-grant admin/owner regardless of what the
        // client sends. This is the actual security boundary for the
        // feature — JoinWorkspacePage.tsx only decides whether to attempt
        // it, this rule decides whether it's allowed.
        allow create: if signedIn()
          && request.auth.uid == memberId
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('autoApproveJoins', false) == true
          && request.auth.token.email is string
          && request.resource.data.email == authEmailLower()
          && request.resource.data.role == 'manager'
          && request.resource.data.status == 'active';

        // Cleanup of the placeholder email-keyed invite doc once claimed.
        allow delete: if signedIn()
          && memberId == resource.data.email
          && resource.data.status == 'invited'
          && isMember(workspaceId)
          && memberDoc(workspaceId, request.auth.uid).data.email == resource.data.email;
      }

      // -----------------------------------------------------------------
      // Join requests — the "request to join instead of creating your own
      // workspace" flow behind a shared /join/:workspaceId link. Anyone
      // signed in may create exactly one request doc for themselves; only
      // the Owner may read the list, approve (by creating a real member
      // record separately), or reject.
      // -----------------------------------------------------------------
      match /joinRequests/{uid} {
        allow read: if hasFullAccess(workspaceId) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.email is string
          && request.auth.token.email is string
          && request.resource.data.email == authEmailLower();
        allow update: if hasFullAccess(workspaceId)
          || (signedIn()
            && request.auth.uid == uid
            && resource.data.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.status == 'pending'
            && resource.data.status in ['rejected', 'pending']
            && request.resource.data.email is string
            && request.auth.token.email is string
            && request.resource.data.email == authEmailLower());
        allow delete: if hasFullAccess(workspaceId) || (signedIn() && request.auth.uid == uid);
      }

      // -----------------------------------------------------------------
      // Pages — only Owner creates/deletes/manages permissions. Read/write
      // of an individual page and its rows is gated by allowedUsers.
      // -----------------------------------------------------------------
      // -----------------------------------------------------------------
      // Manager page quota: one claim per manager uid. The claim and the
      // page it points to must be created together in the SAME write
      // batch — see managerPageQuota.ts. Once a claim exists, a second
      // create() for that uid always fails (exists() check below), so a
      // race between two tabs or a raw repeated Firestore write can never
      // grant a second page.
      // -----------------------------------------------------------------
      match /managerPageClaims/{uid} {
        allow read: if hasFullAccess(workspaceId) || (isMember(workspaceId) && uid == request.auth.uid);
        allow create: if isMember(workspaceId)
          && uid == request.auth.uid
          && hasRole(workspaceId, 'manager')
          && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/managerPageClaims/$(uid))
          && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(request.resource.data.pageId))
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(request.resource.data.pageId)).data.createdBy == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update: if hasFullAccess(workspaceId);
        // changeMemberRole(manager) records the claim for someone who already
        // has exactly one desk — a create on the Owner/Тимлид side, which the
        // self-only create rule above can never allow.
        allow create: if hasFullAccess(workspaceId)
          && request.resource.data.uid == uid
          && request.resource.data.pageId is string;
        // Manager may drop own claim only in the same batch as deleting that page,
        // so deleting the last own desk lets them create one again.
        allow delete: if hasFullAccess(workspaceId) || (
          isMember(workspaceId)
          && uid == request.auth.uid
          && resource.data.pageId is string
          && !existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(resource.data.pageId))
        );
      }

      match /pages/{pageId} {
        // MUST stay isMember (not canAccessPage). The client lists this
        // collection unfiltered so every member can see desk covers / hidden
        // desks. canAccessPage depends on resource.data, so an unfiltered
        // list is always permission-denied for non-owners — Технар then lose
        // their own desk and get «Нет доступа к части данных».
        // Row data still uses canAccessPage below.
        allow read: if isMember(workspaceId);

        // Owner always. Admin/Manager may also create a page, but ONLY as
        // its own responsible person and only if they include themselves in
        // allowedUsers — otherwise they'd create a page invisible to
        // themselves (Admin/Manager have no blanket page access). A Manager
        // additionally may only ever have ONE page: the create is atomically
        // paired (same batch) with a managerPageClaims/{uid} doc, and once
        // that claim exists a second create for the same uid is rejected —
        // including from a second tab or a repeated direct write.
        allow create: if isMember(workspaceId) && request.resource.data.workspaceId == workspaceId &&
          (isOwner(workspaceId) ||
            (myRole(workspaceId) == 'admin' &&
              request.resource.data.responsibleUserId == request.auth.uid &&
              request.auth.uid in request.resource.data.get('allowedUsers', [])) ||
            (hasRole(workspaceId, 'manager') &&
              request.resource.data.createdBy == request.auth.uid &&
              request.resource.data.responsibleUserId == request.auth.uid &&
              request.auth.uid in request.resource.data.get('allowedUsers', []) &&
              !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/managerPageClaims/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/managerPageClaims/$(request.auth.uid)) &&
              getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/managerPageClaims/$(request.auth.uid)).data.pageId == pageId));

        allow update: if isOwner(workspaceId);
        // Тимлид: who sees, edits and answers for a desk — never its content
        // (columns, name, tabs). Keep in sync with the access writes in
        // pageService (updatePagePermissions, updatePageEditableUsers,
        // setPageResponsible, togglePageVisibility).
        allow update: if isTeamLead(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['allowedUsers', 'editableUsers', 'responsibleUserId', 'hiddenByResponsible', 'personalZoneAllowedUsers', 'inactive', 'inactiveAt', 'inactiveBy', 'updatedAt']);
        // Desks are retired to «Неактуальные» (inactive/inactiveAt/inactiveBy,
        // Owner or Тимлид above) instead of being deleted. A hard delete stays
        // with the Owner only (mirrors canDeletePage client-side).
        allow delete: if isOwner(workspaceId);

        // The person assigned as this page's "responsible" gets full control
        // over the page itself (rename, colour/icon, allowedUsers, columns)
        // — everything except reassigning who's responsible, which stays an
        // Owner/Admin-only action (see the Admin rule right below). This is
        // deliberately a plain per-field diff check, not a read/list rule,
        // so it carries none of the "list query" safety constraints that
        // apply to canAccessPage/the pages list query elsewhere in this file.
        // createdBy decides delete rights and workspaceId ties the doc to
        // this workspace, so neither may be rewritten here either.
        allow update: if isMember(workspaceId)
          && resource.data.responsibleUserId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['responsibleUserId', 'createdBy', 'workspaceId', 'inactive', 'inactiveAt', 'inactiveBy']);

        // Admin (not Owner, who already has full rights above) may assign
        // or reassign who's responsible for this page. setPageResponsible()
        // (the only caller of this rule branch) always writes
        // responsibleUserId together with allowedUsers (merges the new
        // responsible person in) and hiddenByResponsible (force-unhides the
        // page) in the SAME call — this used to require the diff to be
        // EXACTLY ['responsibleUserId','updatedAt'], which silently
        // rejected the write (permission-denied) the moment the new
        // responsible person wasn't already in allowedUsers or the page was
        // hidden — i.e. the normal case of assigning someone new. The
        // freshly-assigned person then genuinely had no responsibleUserId
        // recorded and, correctly, none of a responsible person's rights.
        // Still requires responsibleUserId itself to actually be part of
        // the change, so this stays scoped to "reassigning responsibility"
        // and can't be used to twiddle allowedUsers/hiddenByResponsible on
        // a page Admin isn't touching responsibility on (Admin otherwise
        // has NO blanket page access — see the top-of-file comment).
        allow update: if isMember(workspaceId)
          && myRole(workspaceId) == 'admin'
          && 'responsibleUserId' in request.resource.data.diff(resource.data).affectedKeys()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['responsibleUserId', 'allowedUsers', 'hiddenByResponsible', 'updatedAt']);

        match /rows/{rowId} {
          allow read: if isMember(workspaceId) &&
            canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
          allow create, update, delete: if isMember(workspaceId) &&
            canEditPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);

          // Row-level comment threads — anyone with VIEW access to the
          // page (even a Viewer) can read and post; editing/deleting a
          // comment stays restricted to its own author.
          match /comments/{commentId} {
            allow read: if isMember(workspaceId) &&
              canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
            allow create: if isMember(workspaceId) &&
              canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data) &&
              request.resource.data.authorUid == request.auth.uid;
            allow update, delete: if isMember(workspaceId) && resource.data.authorUid == request.auth.uid;
          }
        }

        // -----------------------------------------------------------------
        // Subpages (inner tabs, e.g. "Январь"/"Февраль" inside "Финка") —
        // purely additive nested tables. Access mirrors the parent page
        // exactly: same allowedUsers-gated read, same non-viewer-gated
        // write/create — there is no separate per-subpage permission list.
        // -----------------------------------------------------------------
        match /subpages/{subPageId} {
          allow read: if isMember(workspaceId) &&
            canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
          allow create, delete: if isMember(workspaceId) &&
            canEditPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
          // Editors may rename, archive, reorder and re-column a tab; its
          // identity and Personal Space markers stay put.
          allow update: if isMember(workspaceId) &&
            canEditPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data) &&
            (isOwner(workspaceId) ||
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['pageId', 'workspaceId', 'createdBy', 'personalOwnerUid', 'personalAllowedUsers']));

          match /rows/{rowId} {
            allow read: if isMember(workspaceId) &&
              canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
            allow create, update, delete: if isMember(workspaceId) &&
              canEditPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
          }
        }

        // -----------------------------------------------------------------
        // Per-page chat — anyone with view access to this page (even a
        // Viewer) can read and post; editing/deleting a message stays
        // restricted to its own author.
        // -----------------------------------------------------------------
        match /chat/{messageId} {
          allow read: if isMember(workspaceId) &&
            canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data);
          allow create: if isMember(workspaceId) &&
            canAccessPage(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data) &&
            request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if isMember(workspaceId) && resource.data.authorUid == request.auth.uid;
        }

        // -----------------------------------------------------------------
        // Personal Space — Reports/Finance/Notes nested under this page,
        // keyed by the owning member's uid. Gated by canUsePersonalZone,
        // a STRICTER check than plain page access: the parent page ACL is
        // NOT sufficient by itself, so an ordinary Viewer of the page never
        // automatically sees anyone's personal zone. Every path here is
        // already scoped to one specific zoneUid — never queried unfiltered
        // across zones — so this carries none of the "list query" safety
        // constraints that apply to the shared subpages/pages lists
        // elsewhere in this file.
        // -----------------------------------------------------------------
        match /personalZones/{zoneUid} {
          allow read: if isMember(workspaceId) && canUsePersonalZone(
            workspaceId,
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data,
            zoneUid
          );
          allow create, update: if isMember(workspaceId) && canUsePersonalZone(
            workspaceId,
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data,
            zoneUid
          ) && request.resource.data.uid == zoneUid;

          match /finance/{entryId} {
            allow read: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
            allow create, update: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid)
              && request.resource.data.uid == zoneUid;
            // Delete has no request.resource (no incoming document data) — a
            // rule that reads request.resource.data on a delete always
            // evaluates falsy and silently denies it. This was the exact bug
            // behind "удаление в финансах не работает": every delete was
            // being rejected by the server despite the button doing the
            // right thing client-side.
            allow delete: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
          }

          match /notes/{noteId} {
            allow read: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
            allow create, update: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid)
              && request.resource.data.authorId == zoneUid;
            allow delete: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
          }

          // Debts — "кто мне сколько должен". Same isolated, uid-scoped
          // pattern as finance/notes.
          match /debts/{debtId} {
            allow read: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
            allow create, update: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid)
              && request.resource.data.uid == zoneUid;
            allow delete: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
          }

          // Monthly reports — a SEPARATE collection from the shared
          // `subpages` used by ordinary page tabs (see personalSpaceService.ts
          // for why), already uid-scoped so no list-query safety concern.
          match /reports/{reportId} {
            allow read: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
            allow create, update, delete: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
              get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);

            match /rows/{rowId} {
              allow read: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
                get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
              allow create, update, delete: if isMember(workspaceId) && canUsePersonalZone(workspaceId,
                get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data, zoneUid);
            }
          }
        }
      }

      // -----------------------------------------------------------------
      // View requests — ask the desk's responsible person for view access
      // to a hidden desk. List queries are fromUid==me or toUid==me so they
      // match this rule (Spark-safe, same pattern as notifications).
      // -----------------------------------------------------------------
      match /viewRequests/{requestId} {
        allow read: if isMember(workspaceId) &&
          (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
        allow create: if isMember(workspaceId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.pageId is string
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(request.resource.data.pageId))
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(request.resource.data.pageId)).data.get('responsibleUserId', '') == request.resource.data.toUid;
        allow update: if isMember(workspaceId)
          && resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['approved', 'denied'];
      }

      // -----------------------------------------------------------------
      // History / audit log — Owner-only visibility, matching "Owner sees
      // everything" (regular members can still generate entries by editing
      // pages they have access to, they just can't browse the full log).
      // -----------------------------------------------------------------
      match /history/{entryId} {
        allow read: if isOwner(workspaceId);
        allow create: if isMember(workspaceId) && myRole(workspaceId) != 'viewer';
        allow delete: if isOwner(workspaceId);
      }

      // -----------------------------------------------------------------
      // Leaderboard — a privacy-preserving aggregate, NOT the row data
      // itself. Every member can read every entry (that's the point: it
      // lets managers compare totals without ever getting read access to
      // each other's actual pages/rows). Writing an entry is restricted to
      // whoever is ACTUALLY that page's responsibleUserId (verified
      // against the real page doc, not just self-declared in the payload)
      // or the Owner — so nobody can post fake numbers under another
      // page's id.
      // -----------------------------------------------------------------
      match /leaderboard/{pageId} {
        allow read: if isMember(workspaceId);
        allow write: if isMember(workspaceId) &&
          (isOwner(workspaceId) ||
            get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId))
              .data.get('responsibleUserId', null) == request.auth.uid);
      }

      // -----------------------------------------------------------------
      // Desk load («Технари») — per-desk order COUNTS for the current month,
      // never row data, so every member (incl. an ОС with no desk access)
      // may read them. Written by anyone who may edit that desk's rows
      // (canEditPage against the real page doc), for that page id and its
      // real responsible person only — techRatings trusts both.
      // -----------------------------------------------------------------
      function deskPageData(workspaceId, pageId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)/pages/$(pageId)).data;
      }

      match /deskLoad/{pageId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId)
          && request.resource.data.pageId == pageId
          && canEditPage(workspaceId, deskPageData(workspaceId, pageId))
          && request.resource.data.get('responsibleUserId', '') == deskPageData(workspaceId, pageId).get('responsibleUserId', '');
      }

      // -----------------------------------------------------------------
      // Archived month counts («Общий дашборд» → по месяцам): the desk's
      // DeskLoad as it stood when the desk first published the next month.
      // Counts and sums only, readable by every member. Written in the same
      // transaction as that publish, by whoever may edit the desk; the
      // responsible person isn't checked — it may have changed since.
      // -----------------------------------------------------------------
      match /deskLoadHistory/{docId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId)
          && request.resource.data.pageId is string
          && request.resource.data.monthKey is string
          && docId == request.resource.data.pageId + '_' + request.resource.data.monthKey
          && canEditPage(workspaceId, deskPageData(workspaceId, request.resource.data.pageId));
      }

      // -----------------------------------------------------------------
      // ОС order lists («Технари» → «Ваши заказы»): one doc per desk per ОС
      // nick, id "<pageId>_<osValue>", with the titles/statuses/dates of
      // this month's orders that carry that nick. Only that ОС (their
      // members.osNickValue) and the Owner read it — a Тимлид sees no desk
      // content, another ОС sees no one else's orders. The ОС screen
      // queries where("osValue","==",myNick), which is exactly what the
      // read rule proves. Written like deskLoad: by whoever may edit the
      // desk's rows, for that desk and its real responsible person only.
      // -----------------------------------------------------------------
      match /osOrders/{docId} {
        allow read: if isOwner(workspaceId)
          || (isMember(workspaceId)
            && memberDoc(workspaceId, request.auth.uid).data.get('osNickValue', '') != ''
            && resource.data.osValue == memberDoc(workspaceId, request.auth.uid).data.get('osNickValue', ''));
        allow create, update: if isMember(workspaceId)
          && request.resource.data.pageId is string
          && request.resource.data.osValue is string
          && docId == request.resource.data.pageId + '_' + request.resource.data.osValue
          && canEditPage(workspaceId, deskPageData(workspaceId, request.resource.data.pageId))
          && request.resource.data.get('responsibleUserId', '') == deskPageData(workspaceId, request.resource.data.pageId).get('responsibleUserId', '');
      }

      // -----------------------------------------------------------------
      // Оценки технарей («Технари»). Один документ на ОС, технаря И МЕСЯЦ,
      // id "<osUid>_<technicianUid>_<YYYY-MM>", 1–5 звёзд. В новом месяце
      // оценка ставится заново, прошлый месяц остаётся как итог. Only a real ОС rates, and only
      // with an ОС nick from a Тимлид (members.osNickValue — not
      // self-writable). The FIRST rating needs a recent order from that nick
      // on the Технар's desk: deskLoad.osLastOrderAt[nick] within 30 days
      // (OS_RATING_WINDOW_MS in src/utils/techLoad.ts). Changing the stars
      // later is always allowed. Owner/Тимлид may delete an unfair rating.
      // -----------------------------------------------------------------
      function isValidStars(stars) {
        return stars is int && stars >= 1 && stars <= 5;
      }

      function hasRecentOrderFrom(workspaceId, rating) {
        let me = memberDoc(workspaceId, request.auth.uid).data;
        let load = get(/databases/$(database)/documents/workspaces/$(workspaceId)/deskLoad/$(rating.pageId)).data;
        return me.get('osNickValue', '') != ''
          && rating.osValue == me.get('osNickValue', '')
          && load.get('responsibleUserId', '') == rating.technicianUid
          && load.get('osLastOrderAt', {}).get(rating.osValue, 0) > request.time.toMillis() - 2592000000;
      }

      match /techRatings/{ratingId} {
        // Every member: the rating leaderboard on «Общий дашборд» is for everyone.
        allow read: if isMember(workspaceId);
        allow create: if isMember(workspaceId)
          && hasRole(workspaceId, 'os')
          && request.resource.data.keys().hasOnly(['workspaceId', 'osUid', 'technicianUid', 'stars', 'monthKey', 'osValue', 'pageId', 'createdAt', 'updatedAt'])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.osUid == request.auth.uid
          && request.resource.data.technicianUid is string
          && request.resource.data.technicianUid != request.auth.uid
          && request.resource.data.monthKey is string
          && ratingId == request.auth.uid + '_' + request.resource.data.technicianUid + '_' + request.resource.data.monthKey
          && request.resource.data.pageId is string
          && request.resource.data.osValue is string
          && isValidStars(request.resource.data.stars)
          && hasRecentOrderFrom(workspaceId, request.resource.data);
        allow update: if isMember(workspaceId)
          && hasRole(workspaceId, 'os')
          && resource.data.osUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars', 'updatedAt'])
          && isValidStars(request.resource.data.stars);
        allow delete: if hasFullAccess(workspaceId);
      }

      // -----------------------------------------------------------------
      // Оценки ЗА ЗАКАЗ — вторая, независимая шкала рядом с общей оценкой
      // выше. Один документ на заказ, id "<pageId>_<rowId>", ставит его тот
      // ОС, чей ник стоит в заказе.
      //
      // Проверка права та же, что у общей оценки (hasRecentOrderFrom): саму
      // строку ОС не видит вообще, так что подтвердить «этот заказ мой»
      // правила могут только через deskLoad — свежий заказ с этим ником на
      // столе этого технаря. Это ровно тот же уровень доверия, что уже
      // принят для общей оценки, не слабее.
      //
      // Читают: Owner, сам ОС и сам технарь. Тимлид — НЕТ: в документе лежит
      // название заказа, а Тимлид не видит содержимого столов (как в
      // osOrders выше). Запросы на клиенте — строго where('osUid'==me) или
      // where('technicianUid'==me), иначе неоднородные права уронят list.
      // -----------------------------------------------------------------
      match /orderRatings/{ratingId} {
        allow read: if isOwner(workspaceId)
          || (isMember(workspaceId) && resource.data.osUid == request.auth.uid)
          || (isMember(workspaceId) && resource.data.technicianUid == request.auth.uid);
        allow create, update: if isMember(workspaceId)
          && request.resource.data.osUid == request.auth.uid
          && hasRole(workspaceId, 'os')
          && request.resource.data.keys().hasOnly(['workspaceId', 'pageId', 'rowId', 'osUid', 'osValue',
              'technicianUid', 'stars', 'monthKey', 'title', 'createdAt', 'updatedAt'])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.rowId is string
          && request.resource.data.technicianUid is string
          && request.resource.data.technicianUid != request.auth.uid
          && ratingId == request.resource.data.pageId + '_' + request.resource.data.rowId
          && request.resource.data.monthKey is string
          && isValidStars(request.resource.data.stars)
          && hasRecentOrderFrom(workspaceId, request.resource.data);
        // Свою — сам ОС, чужую несправедливую — Owner/Тимлид.
        allow delete: if hasFullAccess(workspaceId)
          || (isMember(workspaceId) && resource.data.osUid == request.auth.uid);
      }

      // Итоги «сумма/количество» по паре ОС↔Технар, id "<osUid>_<techUid>".
      // Отдельный документ, потому что средним по заказам светит весь
      // «Дашборд», а читать ради него всю растущую коллекцию orderRatings —
      // это лимиты Spark (см. CLAUDE.md). Содержимого заказов тут нет, так
      // что читать может любой участник.
      //
      // Пишет их сам ОС в одной транзакции с оценкой (и Owner/Тимлид, когда
      // снимает чужую) — счётчик, который правит только его владелец.
      // Арифметику правила не пересчитывают (нельзя: другой документ), но
      // держат её в осмысленных границах: count >= 0, а сумма обязана лежать
      // между count и count*5 — то есть накрутить среднее выше пятёрки или
      // ниже единицы нельзя при любом count.
      function saneRatingTotals(data) {
        return data.count is int && data.sum is int
          && data.count >= 0 && data.count <= 100000
          && data.sum >= data.count && data.sum <= data.count * 5;
      }
      match /orderRatingTotals/{totalsId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId)
          && request.resource.data.keys().hasOnly(['workspaceId', 'osUid', 'technicianUid', 'monthKey', 'count', 'sum', 'updatedAt'])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.technicianUid is string
          && request.resource.data.monthKey is string
          && totalsId == request.resource.data.osUid + '_' + request.resource.data.technicianUid + '_' + request.resource.data.monthKey
          && saneRatingTotals(request.resource.data)
          // Сначала бесплатная проверка «это мой документ», потом hasRole —
          // каждый вызов роли это get(), а на одну проверку правил их
          // отпущено всего десяток.
          && (
            (request.resource.data.osUid == request.auth.uid && hasRole(workspaceId, 'os'))
            || hasFullAccess(workspaceId)
          );
        allow delete: if hasFullAccess(workspaceId);
      }

      // -----------------------------------------------------------------
      // Announcements — any member may read; only Owner/Admin may post,
      // edit, pin, archive, or delete.
      // -----------------------------------------------------------------
      match /announcements/{announcementId} {
        allow read: if isMember(workspaceId);
        allow create: if isManagement(workspaceId) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isManagement(workspaceId);
      }

      // -----------------------------------------------------------------
      // GROK LIMIT — credentials and status stay writable by every member
      // (whoever last checked an account updates it for everyone). The
      // `nickname` card title is Owner/Admin only: others may not create
      // or change it. Create/delete of the account itself stay member-wide.
      // Stamp yourself as updatedByUid, never someone else.
      // -----------------------------------------------------------------
      function grokNicknamePreserved() {
        return request.resource.data.get('nickname', '') == resource.data.get('nickname', '');
      }
      function grokCreateNicknameOk(workspaceId) {
        return isManagement(workspaceId) || request.resource.data.get('nickname', '') == '';
      }
      // A pure ОС doesn't see Грок лимит at all (an ОС + Технар does).
      function canUseGrok(workspaceId) {
        return isMember(workspaceId) && (myRole(workspaceId) != 'os' || hasExtraRole(workspaceId, 'manager'));
      }

      // Daily dispatch board (Выдача) — standalone sidebar section, not tied
      // to any one desk. Owner/admin manage the whole board. The one
      // exception: the technician a pending entry is assigned to (a real
      // account, via a DispatchTechnician roster link) can read that one
      // entry and flip requestStatus to accept it — nothing else on the
      // doc, so a Технар can never touch checkNo/amount/marks/etc. this way.
      match /dailyDispatches/{dispatchId} {
        allow read: if isOwnerOrAdmin(workspaceId) || resource.data.get('technicianUid', null) == request.auth.uid;
        allow create, delete: if isOwnerOrAdmin(workspaceId);
        allow update: if isOwnerOrAdmin(workspaceId) ||
          (resource.data.get('technicianUid', null) == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['requestStatus', 'acceptedAt', 'sheetRowId']));
      }

      // Admin-curated technician nickname roster for Выдача. Nicknames:
      // Admin+. Linking a nickname to a real account (memberUid): Owner
      // only — the same weight as binding a dispatch entry to a desk.
      match /dispatchTechnicians/{techId} {
        allow read: if isOwnerOrAdmin(workspaceId) ||
          resource.data.get('memberUid', null) == request.auth.uid;
        allow create: if isOwnerOrAdmin(workspaceId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isOwnerOrAdmin(workspaceId) &&
          (isOwner(workspaceId) ||
            !('memberUid' in request.resource.data.diff(resource.data).affectedKeys()));
        allow delete: if isOwnerOrAdmin(workspaceId);
      }

      match /grokAccounts/{accountId} {
        allow read: if canUseGrok(workspaceId);
        allow create: if canUseGrok(workspaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedByUid == request.auth.uid
          && grokCreateNicknameOk(workspaceId);
        allow update: if canUseGrok(workspaceId)
          && request.resource.data.updatedByUid == request.auth.uid
          && (isManagement(workspaceId) || grokNicknamePreserved());
        allow delete: if canUseGrok(workspaceId);
      }

      match /grokAppAccounts/{accountId} {
        allow read: if canUseGrok(workspaceId);
        allow create: if canUseGrok(workspaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedByUid == request.auth.uid
          && grokCreateNicknameOk(workspaceId);
        allow update: if canUseGrok(workspaceId)
          && request.resource.data.updatedByUid == request.auth.uid
          && (isManagement(workspaceId) || grokNicknamePreserved());
        allow delete: if canUseGrok(workspaceId);
      }

      // -----------------------------------------------------------------
      // Notifications — fan-out, one doc per recipient. Only the Owner may
      // send (create) notifications. Each person may only read/update
      // (mark-as-read) their own — never anyone else's — and may delete
      // their own to clear it from their list.
      // -----------------------------------------------------------------
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && resource.data.targetUid == request.auth.uid;
        allow update: if signedIn()
          && resource.data.targetUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // Owner-only BROADCAST sending (the Announcements "notify" picker)
        // is enforced by the client UI, not here — this rule's job is just
        // to stop someone from faking who a notification is "from". Any
        // member may create a notification for this reason: @mentions in
        // chat/comments need to let ANY member ping ANY other member, not
        // just the Owner.
        allow create: if isMember(workspaceId) && request.resource.data.fromUid == request.auth.uid;
      }

      // -----------------------------------------------------------------
      // Workspace group chat — any member may read/post; editing or
      // deleting a message is restricted to its own author.
      // -----------------------------------------------------------------
      match /workspaceChat/{messageId} {
        allow read: if isMember(workspaceId);
        allow create: if isMember(workspaceId) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isMember(workspaceId) && resource.data.authorUid == request.auth.uid;
      }

      // -----------------------------------------------------------------
      // Private (1:1) messages. chatId is a deterministic pairing of the
      // two participants' uids, e.g. "<uidA>_<uidB>" sorted — so anyone
      // can be verified as a legitimate participant just from the chatId
      // itself, without needing a separate membership document.
      // -----------------------------------------------------------------
      function isInPrivateChat(chatId) {
        return chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid;
      }
      match /privateChats/{chatId} {
        // Two ways to qualify: the chatId-derived check (fine for reading
        // one already-known conversation) OR — needed for the "list all my
        // conversations" query, which filters by
        // where("participants","array-contains",uid) — a check on the
        // `participants` FIELD itself, so Firestore can prove that query
        // safe the same way it proves the allowedUsers array-contains
        // pattern used for pages.
        allow read, write: if isMember(workspaceId) &&
          (isInPrivateChat(chatId) || request.auth.uid in resource.data.get('participants', []));
        allow create: if isMember(workspaceId) &&
          (isInPrivateChat(chatId) || request.auth.uid in request.resource.data.get('participants', []));
        match /messages/{messageId} {
          allow read: if isMember(workspaceId) && isInPrivateChat(chatId);
          allow create: if isMember(workspaceId) && isInPrivateChat(chatId) && request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if isMember(workspaceId) && isInPrivateChat(chatId) && resource.data.authorUid == request.auth.uid;
        }
      }

      // -----------------------------------------------------------------
      // Read markers — "when did I last read this conversation" per
      // context (workspace chat / a specific private chat). Strictly
      // self-service: the doc's own `uid` field must match the caller, and
      // list queries always filter by `where("uid","==",me)`, matching
      // this rule's per-doc condition exactly (the same safe pattern used
      // for notifications).
      // -----------------------------------------------------------------
      match /readMarkers/{markerId} {
        allow read: if isMember(workspaceId) && resource.data.uid == request.auth.uid;
        allow create, update: if isMember(workspaceId) && request.resource.data.uid == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------
    // Collection-group read for claimPendingInvites() (memberService.ts):
    // on every login it runs collectionGroup(db, "members") filtered to
    // its OWN email + status=='invited', to find a pending invite in ANY
    // workspace at once (there's no other way to discover "which
    // workspaces invited me" without knowing every workspace id up
    // front). A nested `match /workspaces/{workspaceId}/members/{id}`
    // rule does NOT authorize a collection-group query — Firestore only
    // applies a rule to a collection-group query when it's written with
    // the recursive `{path=**}` wildcard, and this file had none for
    // "members". That made the query ALWAYS permission-denied, for every
    // user, on every login — silently, since useAuth.ts's catch around
    // this call specifically swallows permission-denied here (to avoid
    // toasting an error on a normal reload with nothing to claim). Net
    // effect: an admin-issued email invite (inviteMember(), the
    // "Пригласить" flow on /people) was NEVER auto-claimed when the
    // invited person actually signed in — they were stuck as a
    // status:'invited' stub forever, with no real membership ever
    // created, no matter how many times they logged in. Only the
    // separate self-join-by-link flow (selfJoinWorkspace/
    // approveJoinRequest, which never goes through this query) worked.
    // Mirrors the read condition already granted per-workspace by the
    // nested members read rule's 3rd clause above — only ever exposes a
    // doc matching the caller's OWN email that's still status:'invited'.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && request.auth.token.email is string
        && resource.data.email == authEmailLower()
        && resource.data.status == 'invited';
    }
  }
}
